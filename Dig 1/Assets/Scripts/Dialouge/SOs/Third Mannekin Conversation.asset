  m_Name: Third Mannekin Conversation
  m_EditorClassIdentifier: Assembly-CSharp::DialougeText
  npcName: Mannequin
  paragraphs:
  - 'Heyy, you finally found that useless stick. '
  - 'Try using it as a boomerang by pressing R.  '
  - 'I tried ignoring all my problems once, but they came back like a boomerang. '
  - 'Throw it at the pufferfish blocking the entrences. '
